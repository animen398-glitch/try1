{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASA Audit Compare",
  "type": "object",
  "required": ["project", "baseline_run_id", "candidate_run_id", "summary"],
  "properties": {
    "project": {"type": "string"},
    "baseline_run_id": {"type": "string"},
    "candidate_run_id": {"type": "string"},
    "inconclusive": {"type": "boolean"},
    "new": {"type": "array"},
    "resolved": {"type": "array"},
    "regressed": {"type": "array"},
    "improved": {"type": "array"},
    "unchanged": {"type": "array"},
    "summary": {
      "type": "object",
      "required": ["new", "resolved", "regressed", "improved", "unchanged"],
      "properties": {
        "new": {"type": "integer"},
        "resolved": {"type": "integer"},
        "regressed": {"type": "integer"},
        "improved": {"type": "integer"},
        "unchanged": {"type": "integer"},
        "risk_regression": {"type": "boolean"}
      }
    },
    "gate": {
      "type": "object",
      "properties": {
        "passed": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
