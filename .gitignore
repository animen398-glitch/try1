# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Test / tooling caches
.pytest_cache/

# PyInstaller build artefacts
build/
dist/
*.manifest

# Generated / runtime output
live_test_output/
~/

# SQLite operation history (runtime DB; keep the data/ dir tracked)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Runtime system log
data/*.log

# Secrets & local environment
.env
.env.*
configs/secrets.json

# Local-only Claude Code settings (keep rules/ and skills/ tracked)
.claude/settings.local.json

# IDE / editor artefacts
.idea/
.vscode/
*.swp
*~

# OS artefacts
.DS_Store
Thumbs.db
