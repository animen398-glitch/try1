# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Test / tooling caches
.pytest_cache/
.pytest-tmp/
# Windows pytest teardown-quirk leftovers (project-rollback temp trees)
.pytest-project-rollback-*/
.pytest-full-project-rollback-*/

# PyInstaller build artefacts
build/
dist/
dist_pyside6/
*.manifest

# Generated / runtime output
live_test_output/
temp/
reports/
~/

# Demo workspace produced by demo_seed.py (self-contained, regenerable)
demo_workspace/

# SQLite operation history (runtime DB; keep the data/ dir tracked)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Runtime system log
data/*.log

# Crash reports & faulthandler dump (WS2 crash reporter; runtime, local-first)
data/crashes/

# Secrets & local environment
.env
.env.*
configs/secrets.json
sessionid

# Vendored third-party tool sources (reference only — reimplemented natively
# or invoked as a subprocess; not part of the app, kept out of the repo)
vendor/
tools/

# Local-only Claude Code settings (keep rules/ and skills/ tracked)
.claude/settings.local.json

# IDE / editor artefacts
.idea/
.vscode/
*.swp
*~

# OS artefacts
.DS_Store
Thumbs.db
